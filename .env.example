# Public site URL used for canonical links, sitemap, and auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase. The service-role key is server-only. Never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Use test-mode keys until a production review.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Transactional email. Sends are skipped until both values exist.
# LEAD_NOTIFY_EMAIL is an optional internal inbox. No team copy is sent until it is set.
RESEND_API_KEY=
EMAIL_FROM=
LEAD_NOTIFY_EMAIL=

# Observability. Both stay off until set.
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Inngest.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Model gateway. Keys stay on the server. A call also requires project-level data-handling approval.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Optional Stripe Connect account country, recorded only. Payouts are not sent until legally approved.
STRIPE_CONNECT_ENABLED=false
